{
  "name": "hangfolio-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/theme",
    "starter",
    "fixtures/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run -ws --if-present build",
    "test": "npm test -w packages/theme",
    "test:golden": "npm run test:golden -w packages/theme",
    "test:e2e": "npm run test:e2e -w packages/theme",
    "test:a11y": "npm run test:a11y -w packages/theme",
    "test:screenshots": "npm run test:screenshots -w packages/theme",
    "test:starter-scenario": "npm run test:starter-scenario -w packages/theme",
    "docs:check": "node tools/docs-check.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5"
  }
}
