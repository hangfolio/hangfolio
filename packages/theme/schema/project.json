{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/hangfolio@1/schema/project.json",
  "title": "hangfolio: content/projects/<id>.md (front matter)",
  "type": "object",
  "properties": {
    "example": {
      "default": false,
      "description": "While true, this project is the example and stays hidden on your site.",
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kicker": {
      "description": "A short line above the title, e.g. \"CLI · Rust\".",
      "type": "string",
      "minLength": 1
    },
    "group": {
      "default": "Projects",
      "description": "The heading this project is listed under on /projects.",
      "type": "string",
      "minLength": 1
    },
    "order": {
      "description": "Position on /projects. Default: file order.",
      "type": "integer"
    },
    "start": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999
        }
      ]
    },
    "end": {
      "anyOf": [
        {
          "const": "present"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999
        }
      ]
    },
    "margin": {
      "description": "Margin text instead of the dates.",
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "terminal": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "label",
              "lines"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "profile"
                ],
                "additionalProperties": false
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "compact": {
      "default": false,
      "description": "A one-line entry.",
      "type": "boolean"
    },
    "listed": {
      "default": true,
      "description": "false: shown on the home page only.",
      "type": "boolean"
    },
    "home": {
      "description": "Features the project in \"Selected work\" on the home page.",
      "type": "object",
      "properties": {
        "order": {
          "type": "integer"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "tag": {
                  "default": "Result",
                  "type": "string",
                  "minLength": 1
                },
                "parts": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "muted": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "parts"
              ],
              "additionalProperties": false
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "profile": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "profile"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "footnote": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exhibit": {
          "type": "object",
          "properties": {
            "terminal": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "label",
                "lines"
              ],
              "additionalProperties": false
            },
            "metrics": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "rows": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "before": {
                        "type": "string",
                        "minLength": 1
                      },
                      "after": {
                        "type": "string",
                        "minLength": 1
                      },
                      "highlight": {
                        "default": false,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "label",
                      "before",
                      "after"
                    ],
                    "additionalProperties": false
                  }
                },
                "footer": {
                  "type": "string",
                  "minLength": 1
                },
                "footerMuted": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "rows"
              ],
              "additionalProperties": false
            },
            "bars": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "rows": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "tone": {
                        "type": "string",
                        "enum": [
                          "accent",
                          "faint"
                        ]
                      }
                    },
                    "required": [
                      "label",
                      "value",
                      "tone"
                    ],
                    "additionalProperties": false
                  }
                },
                "caption": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label",
                "rows",
                "caption"
              ],
              "additionalProperties": false
            },
            "install": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "order"
      ],
      "additionalProperties": false
    },
    "result": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "default": "Result",
              "type": "string",
              "minLength": 1
            },
            "parts": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "muted": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "parts"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "title",
    "summary"
  ],
  "additionalProperties": false
}
