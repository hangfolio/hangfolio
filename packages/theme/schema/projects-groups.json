{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/hangfolio@1/schema/projects-groups.json",
  "title": "hangfolio: content/projects.yaml",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][\\w-]*$"
          },
          "headingId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][\\w-]*$"
          },
          "link": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "href": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "href"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "profile"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
