{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/hangfolio@1/schema/news.json",
  "title": "hangfolio: content/news.yaml",
  "type": "object",
  "properties": {
    "items": {
      "description": "Newest first.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "default": false,
            "description": "While true, this item is the example and stays hidden on your site.",
            "type": "boolean"
          }
        },
        "required": [
          "date",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
