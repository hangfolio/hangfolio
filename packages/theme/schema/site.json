{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/hangfolio@1/schema/site.json",
  "title": "hangfolio: site.yaml",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Your name: the page heading, titles and footer."
    },
    "tagline": {
      "description": "The big sentence under your name.",
      "type": "string",
      "minLength": 1
    },
    "role": {
      "description": "For example \"PhD student in Computer Science\".",
      "type": "string",
      "minLength": 1
    },
    "affiliation": {
      "description": "A name, or { name, url }.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "email": {
      "type": "string",
      "minLength": 1,
      "description": "Shown as a mailto link."
    },
    "nameVariants": {
      "default": [],
      "description": "Other spellings of your name in author lists, to underline.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "locationLong": {
      "description": "The contact page location. Default: location.",
      "type": "string",
      "minLength": 1
    },
    "pronouns": {
      "type": "string",
      "minLength": 1
    },
    "avatar": {
      "description": "Your photo, e.g. /images/me.jpg. Default: public/images/avatar.jpg, .png or .webp if there is one, else your initials.",
      "type": "string",
      "minLength": 1
    },
    "avatarAlt": {
      "type": "string",
      "minLength": 1
    },
    "ogImage": {
      "description": "The social preview image. Default: avatar.",
      "type": "string",
      "minLength": 1
    },
    "cv": {
      "description": "Your CV, e.g. /files/cv.pdf. Adds the CV link and the Résumé button.",
      "type": "string",
      "minLength": 1
    },
    "links": {
      "description": "Profiles and other sites: a bare URL, or { url, label, id, hero, contact, footer }.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "hero": {
                "default": true,
                "type": "boolean"
              },
              "contact": {
                "default": true,
                "type": "boolean"
              },
              "footer": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "availability": {
      "description": "A status callout on the home and contact pages.",
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "minLength": 1
        },
        "emailSubject": {
          "type": "string",
          "minLength": 1
        },
        "until": {
          "description": "Hidden after this date (UTC).",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            }
          ]
        }
      },
      "required": [
        "headline"
      ],
      "additionalProperties": false
    },
    "booking": {
      "description": "Adds a booking page (/meet): { calcom } or { link }.",
      "type": "object",
      "properties": {
        "calcom": {
          "description": "Your Cal.com name and event, like your-name/30min.",
          "type": "string",
          "minLength": 1
        },
        "link": {
          "description": "Any booking page; the site only links to it.",
          "type": "string",
          "minLength": 1
        },
        "label": {
          "default": "Book a 1:1",
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "lede": {
          "type": "string",
          "minLength": 1
        },
        "emailSubject": {
          "default": "Meeting request",
          "type": "string",
          "minLength": 1
        },
        "keepPageWhenOff": {
          "default": false,
          "description": "true: with neither calcom nor link (booking paused), the page stays and points to email.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "nav": {
      "description": "The header links. Default: every page with content.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "research",
              "projects",
              "publications",
              "experience",
              "writing",
              "cv",
              "booking",
              "contact"
            ]
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "jobTitle": {
          "type": "string",
          "minLength": 1
        },
        "alumniOf": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knowsAbout": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": {
          "description": "One colour, or { light, dark }. Checked for contrast.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            {
              "type": "object",
              "properties": {
                "light": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                },
                "dark": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                }
              },
              "required": [
                "light"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "description": "Turn pages off (false) or change their path and text.",
      "default": {},
      "type": "object",
      "properties": {
        "projects": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "publications": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                },
                "prepAside": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "experience": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "writing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "contact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "meet": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "card": {
          "description": "Reserved for a later version; leave it out.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "notFound": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "redirects": {
      "description": "Old addresses that forward to new ones.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "url": {
      "description": "Pins the site address; normally detected from GitHub Pages.",
      "type": "string",
      "minLength": 1
    },
    "advanced": {
      "description": "Rarely needed; see docs/site-yaml.md.",
      "default": {},
      "type": "object",
      "properties": {
        "urlFormat": {
          "default": "preserve",
          "type": "string",
          "enum": [
            "preserve",
            "directory"
          ]
        },
        "trailingSlash": {
          "default": "ignore",
          "type": "string",
          "enum": [
            "ignore",
            "always",
            "never"
          ]
        },
        "lang": {
          "default": "en",
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "default": "en_US",
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "default": "UTC",
          "description": "For the footer's \"Last updated\".",
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "description": "The header home link. Default: the site's host.",
          "type": "string",
          "minLength": 1
        },
        "titleSuffix": {
          "default": " — {name}",
          "type": "string"
        },
        "writingPath": {
          "type": "string",
          "minLength": 1
        },
        "feed": {
          "default": {},
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "default": "{name} — Writing",
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "sitemapAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "googleVerification": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[\\w.-]+$"
            },
            "meta": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[\\w.-]+$"
            }
          },
          "additionalProperties": false
        },
        "anchors": {
          "default": {},
          "type": "object",
          "properties": {
            "highlights": {
              "default": "results",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            },
            "work": {
              "default": "work",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            },
            "research": {
              "default": "research",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            },
            "experience": {
              "default": "exp",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            },
            "education": {
              "default": "education",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            },
            "news": {
              "default": "news",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            },
            "writing": {
              "default": "writing",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            },
            "contact": {
              "default": "contact",
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][\\w-]*$"
            }
          },
          "additionalProperties": false
        },
        "labels": {
          "default": {},
          "type": "object",
          "properties": {
            "minRead": {
              "default": "min read",
              "type": "string",
              "minLength": 1
            },
            "allWriting": {
              "default": "← All writing",
              "type": "string",
              "minLength": 1
            },
            "now": {
              "default": "Now:",
              "type": "string",
              "minLength": 1
            },
            "src": {
              "default": "src ·",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "footer": {
          "default": {},
          "type": "object",
          "properties": {
            "links": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "href": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "href"
                ],
                "additionalProperties": false
              }
            },
            "showUpdated": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "nameParts": {
          "description": "Your name split for the contact card. Default: the last word is the family name.",
          "type": "object",
          "properties": {
            "given": {
              "type": "string",
              "minLength": 1
            },
            "family": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "given",
            "family"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "email"
  ],
  "additionalProperties": false
}
