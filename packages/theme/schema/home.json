{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/hangfolio@0/schema/home.json",
  "title": "hangfolio: content/home.yaml",
  "type": "object",
  "properties": {
    "example": {
      "default": false,
      "description": "While true, this file is the example and stays hidden on your site.",
      "type": "boolean"
    },
    "intro": {
      "description": "The paragraph under your tagline.",
      "type": "string",
      "minLength": 1
    },
    "now": {
      "description": "The \"Now:\" line.",
      "type": "string",
      "minLength": 1
    },
    "highlights": {
      "type": "object",
      "properties": {
        "heading": {
          "default": "Results at a glance",
          "type": "string",
          "minLength": 1
        },
        "items": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "The number, e.g. \"up to 40%\" or \"3s → 300ms\"."
              },
              "what": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "asOf": {
                "description": "When the number was measured; a warning after 180 days.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 9999
                  }
                ]
              }
            },
            "required": [
              "value",
              "what"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "approach": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "chip": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "featured": {
          "description": "A publication key from content/publications.bib.",
          "type": "string",
          "minLength": 1
        },
        "teaching": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label",
                "href"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "profile"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "default": [
        "highlights",
        "work",
        "research",
        "experience",
        "education",
        "news",
        "writing",
        "contact"
      ],
      "description": "The sections in order; leave one out to hide it.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "highlights",
          "work",
          "research",
          "experience",
          "education",
          "news",
          "writing",
          "contact"
        ]
      }
    },
    "counts": {
      "default": {},
      "type": "object",
      "properties": {
        "experience": {
          "default": 5,
          "type": "integer",
          "minimum": 0
        },
        "news": {
          "default": 4,
          "type": "integer",
          "minimum": 0
        },
        "writing": {
          "default": 2,
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "headings": {
      "default": {},
      "type": "object",
      "properties": {
        "work": {
          "default": "Selected work",
          "type": "string",
          "minLength": 1
        },
        "experience": {
          "default": "Experience",
          "type": "string",
          "minLength": 1
        },
        "education": {
          "default": "Education",
          "type": "string",
          "minLength": 1
        },
        "news": {
          "default": "News",
          "type": "string",
          "minLength": 1
        },
        "writing": {
          "default": "Writing",
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "default": "Get in touch",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
