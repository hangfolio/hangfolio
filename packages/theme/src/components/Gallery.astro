---
// Photos under an experience entry (SPEC 5.7): thumbnails two to a row (one under 540px), each
// linking to its full-size image, and an optional caption (inline Markdown).
import { inlineMd } from '../lib/inline-md.ts';
import { contentUrl } from '../lib/url.ts';

interface Props {
  caption?: string;
  images: { thumb: string; full: string; alt: string; width: number; height: number }[];
}

const { caption, images } = Astro.props;
---
<figure class="gallery">
  <div class="shots">
    {images.map((image) => (
      <a href={contentUrl(image.full)}>
        <img src={contentUrl(image.thumb)} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
  {caption && <figcaption set:html={inlineMd(caption)} />}
</figure>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: .625rem;
    max-width: 36rem;
    margin-top: .75rem;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
  }

  .shots a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--tint);
  }

  .shots a:hover {
    border-color: var(--rule-strong);
  }

  .shots img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    font-size: .875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 540px) {
    .shots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
