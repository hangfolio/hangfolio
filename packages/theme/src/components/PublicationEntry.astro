---
// One paper on the publications page (lib/bib-page.ts works out what it shows): the year and
// short venue in the margin; the title, the authors (the site owner underlined, * for equal
// contribution) and their note, the venue and place, and the DOI; the data line and the links;
// then the summary (the default slot: the extras file's body) and the BibTeX block.
import BibtexBlock from './BibtexBlock.astro';
import type { PaperView } from '../lib/bib-page.ts';
import { inlineMd } from '../lib/inline-md.ts';
import { contentUrl } from '../lib/url.ts';

interface Props {
  view: PaperView;
}

const { anchor, year, abbr, title, authors, note, venue, place, doi, data, links, bibtexAnchor, bibtex, bibtexLabel } = Astro.props.view;
const titleId = `${anchor}-title`;
---
<article class="hang" id={anchor} aria-labelledby={title ? titleId : undefined}>
  <div class="m">{year && <span class="n">{year}</span>}{abbr && <span>{abbr}</span>}</div>
  <div class="paper">
    <div class="cite">
      {title && <h3 id={titleId} class="ptitle" set:html={title} />}
      {authors.length > 0 && <p class="authors">{authors.map((author, i) => <>{i > 0 && ', '}{author.me ? <span class="me">{author.name}</span> : author.name}{author.equal && '*'}</>)}</p>}
      {note && <p class="note">{note}</p>}
      {(venue || place) && <p class="venue-line">{venue && <em class="venue" set:html={venue} />}{place && (venue ? `, ${place}` : place)}</p>}
      {doi && <p class="doi"><a href={doi.href}>doi:{doi.text}</a></p>}
    </div>
    {data && <p class="result"><span class="tag">{data.tag}</span><span set:html={inlineMd(data.text)} /></p>}
    <div class="links mono">{links.map((link) => <a href={contentUrl(link.href)}>[{link.label}]</a>)}</div>
    {Astro.slots.has('default') && (
      <div class="part">
        <div class="sec-head"><h4 class="eyebrow">Summary</h4></div>
        <div class="prose summary"><slot /></div>
      </div>
    )}
    <BibtexBlock id={bibtexAnchor} text={bibtex} label={bibtexLabel} />
  </div>
</article>

<style>
  .paper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .cite {
    display: flex;
    flex-direction: column;
    gap: .375rem;
  }

  .ptitle {
    margin-bottom: .25rem;
    font-family: var(--serif);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -.01em;
    text-wrap: balance;
  }

  .authors {
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .venue-line {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .venue {
    font-family: var(--serif);
    font-size: 1.0625rem;
    color: var(--fg);
  }

  .note {
    font-size: .875rem;
    color: var(--muted);
  }

  .doi {
    font-family: var(--mono);
    font-size: .8125rem;
    overflow-wrap: anywhere;
  }

  .doi a {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
  }

  .part {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    min-width: 0;
    padding-top: 1rem;
  }

  .summary {
    font-size: 1rem;
    line-height: 1.65;
  }

  .summary :global(p) {
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .ptitle {
      font-size: 1.375rem;
    }

    .doi a {
      min-height: 2.75rem;
    }
  }
</style>
