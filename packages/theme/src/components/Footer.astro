---
// Site footer: the profile links, the contact page and advanced.footer.links from site.yaml, then
// the copyright line and the month the site was built. The RSS link shows while there is a feed
// (lib/endpoints.ts).
import { build, site } from 'virtual:hangfolio/site';
import { pagePath } from '../lib/nav.ts';
import { localeTag } from '../lib/site.ts';
import { url } from '../lib/url.ts';

const footer = site.advanced.footer;
const contact = pagePath(site, 'contact');
const links = [
  ...site.links.filter((link) => link.footer).map((link) => ({ label: link.label, href: link.url })),
  ...(contact ? [{ label: 'Contact', href: contact }] : []),
  ...footer.links,
  ...(build.head.feed ? [{ label: 'RSS', href: build.head.feed.path }] : []),
];

// "Last updated" is the month the site was built and deployed, in advanced.timezone
const timeZone = site.advanced.timezone;
const now = new Date();
const updated = now.toLocaleDateString(localeTag(site), { month: 'long', year: 'numeric', timeZone });
const year = now.toLocaleDateString(localeTag(site), { year: 'numeric', timeZone });
---
<footer class="foot">
  {links.length > 0 && (
    <nav aria-label="Elsewhere" class="row">
      {links.map((link) => <a href={url(link.href)}>{link.label}</a>)}
    </nav>
  )}
  <p class="small"><span>© {year} {site.name}</span>{footer.showUpdated && <span>Last updated {updated}</span>}</p>
</footer>

<style>
  .foot {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.375rem;
    font-size: .9375rem;
  }

  .row a {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
  }

  .small {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem 1.25rem;
    font-family: var(--mono);
    font-size: .75rem;
    color: var(--faint);
  }

  @media (max-width: 720px) {
    .row a {
      min-height: 2.75rem;
    }
  }
</style>
