---
// Bars drawn to scale: each width is value / max, rounded to 0.1% (lib/exhibits.ts). To a screen
// reader the rows are one image whose label carries every value; the caption is read after it.
// Every row is a three-column grid; the label and value columns are at least 2.75rem and 4.25rem
// wide, and as wide as the longest label and value (in ch: the well is monospace), so the tracks
// line up from row to row.
import { barColumns, barRows, barsLabel, type Bars } from '../lib/exhibits.ts';
import { inlineMd } from '../lib/inline-md.ts';

type Props = Bars;

const bars = Astro.props;
const rows = barRows(bars);
const { label, value } = barColumns(rows);
---
<figure class="well bars">
  <div class="bar-rows" role="img" aria-label={barsLabel(bars)} style={`--label: ${label}ch; --value: ${value}ch`}>
    {rows.map((row) => (
      <div class="bar-row">
        <span>{row.label}</span>
        <span class="track"><span class={row.tone === 'faint' ? 'fill low' : 'fill'} style={`width: ${row.width}`}></span></span>
        <span class="val">{row.value}</span>
      </div>
    ))}
  </div>
  <figcaption set:html={inlineMd(bars.caption)} />
</figure>
