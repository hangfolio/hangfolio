---
// The initials monogram, drawn with the accent token, that stands in for the avatar when there
// is no photo or the photo is still the example (SPEC 5.2 rule 4). Decorative: the name is beside it.
import { site } from 'virtual:hangfolio/site';
import { initials } from '../lib/avatar.ts';

interface Props {
  /** The diameter in rem */
  size?: number;
}

const { size = 6 } = Astro.props;
---
<span class="monogram" aria-hidden="true" style={`--size: ${size}rem`}>{initials(site.name, site.advanced.nameParts)}</span>

<style>
  .monogram {
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--tint);
    border: 1px solid var(--rule);
    color: var(--accent);
    font-family: var(--serif);
    font-size: calc(var(--size) * .4);
    line-height: 1;
    letter-spacing: .02em;
    user-select: none;
  }
</style>
