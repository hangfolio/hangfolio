---
// Interior page: a serif title, an optional lede, then the page body.
import Base from './Base.astro';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof Base> & {
  heading: string;
  lede?: string;
};

const { heading, lede, ...base } = Astro.props;
---
<Base {...base}>
  <header class="page-head">
    <slot name="eyebrow" />
    <h1>{heading}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot name="meta" />
  </header>
  <slot />
</Base>
