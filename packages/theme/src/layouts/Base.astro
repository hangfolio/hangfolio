---
// Every page's document: head and SEO tags, the pre-paint theme script, icons and the manifest,
// feed and sitemap links (lib/endpoints.ts), the generator line with the theme version and build
// SHA, the JSON-LD graph (lib/jsonld.ts), the skip link, and the header and footer around the body.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import tokensCss from '../styles/tokens.css?raw';
import { build, demo, help, site } from 'virtual:hangfolio/site';
import DevChecks from '../components/DevChecks.astro';
import ExampleBanner from '../components/ExampleBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { checkError, currentDevState, DROP_STALE_OVERLAY } from '../lib/dev-checks.ts';
import { generatorContent, nameParts } from '../lib/head.ts';
import { blogPosting, contactPage, pageNodes, siteGraph } from '../lib/jsonld.ts';
import { siteDescription } from '../lib/site.ts';
import { parseTokens } from '../lib/tokens.ts';
import { absUrl, url } from '../lib/url.ts';

interface Props {
  /** The full <title> */
  title: string;
  description?: string;
  /** Canonical path, site-relative and written exactly as the live URL (e.g. "/projects", "/writing/") */
  path: string;
  /** The nav key to mark as the current page */
  nav?: string;
  ogType?: 'website' | 'profile' | 'article';
  ogImage?: string;
  keywords?: string;
  noindex?: boolean;
  /** A post: its dates and tags, and its headline for JSON-LD (default: the title without the suffix) */
  article?: { published: Date; modified?: Date; tags?: readonly string[]; headline?: string };
  /** Extra JSON-LD nodes for this page, added to the site graph */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = siteDescription(site),
  path,
  nav,
  ogType = 'website',
  ogImage = site.ogImage ?? site.avatar,
  keywords = site.seo?.keywords?.join(', '),
  noindex: noindexPage = false,
  article,
  schema = [],
} = Astro.props;

// The example site is never indexed (SPEC 5.2).
const noindex = noindexPage || demo;

// In `hangfolio dev`, errors from the checks show as Astro's error overlay on every page.
const dev = import.meta.env.DEV ? await currentDevState() : undefined;
if (dev && dev.errors.length > 0) throw checkError(dev, help);
const devIssues = (dev?.others ?? []).filter((issue) => !issue.page || issue.page === path);

const canonical = absUrl(path);
const image = ogImage ? absUrl(ogImage) : undefined;
const personImage = site.ogImage ?? site.avatar;
const profile = ogType === 'profile' ? nameParts(site) : undefined;

// The page's JSON-LD: a post gets its BlogPosting and the contact page its ContactPage, unless the
// page passes a node with the same @id itself (lib/jsonld.ts).
const suffix = site.advanced.titleSuffix.replaceAll('{name}', site.name);
const headline = article?.headline ?? (suffix && title.endsWith(suffix) ? title.slice(0, -suffix.length) : title);
const contact = site.pages.contact;
const nodes = pageNodes(schema, [
  article && blogPosting(site, { path, headline, description, published: article.published, modified: article.modified, tags: article.tags }),
  contact && contact.path === path ? contactPage(path, title) : undefined,
]);
const graph = siteGraph(site, personImage ? absUrl(personImage) : undefined, nodes);
const { light } = parseTokens(tokensCss);
const { head } = build;
const verification = path === '/' ? site.advanced.googleVerification?.meta : undefined;
---
<!doctype html>
<html lang={site.advanced.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {verification && <meta name="google-site-verification" content={verification} />}

    <meta property="og:locale" content={site.advanced.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:type" content={ogType} />
    {profile && <meta property="profile:first_name" content={profile.given} />}
    {profile?.family && <meta property="profile:last_name" content={profile.family} />}
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={light.bg} />
    <script is:inline>
      /* Apply a saved light/dark choice before first paint; no saved choice follows the OS */
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>

    {head.icons.map((icon) => <link rel={icon.rel} type={icon.type} sizes={icon.sizes} href={url(icon.href)} color={icon.mask ? light.accent : undefined} />)}
    <link rel="manifest" href={url(head.manifest)} />
    {head.feed && <link rel="alternate" type="application/rss+xml" title={head.feed.title} href={url(head.feed.path)} />}
    <link rel="sitemap" href={url(head.sitemap)} />
    <meta name="generator" content={generatorContent(build.version, Astro.generator, build.sha)} />

    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip" href={url('#main')}>Skip to content</a>
    {demo && <ExampleBanner />}
    <div class="wrap shell">
      <Header current={nav} />
      <main id="main" class="page" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    {devIssues.length > 0 && <DevChecks issues={devIssues} />}
    {dev && <script is:inline set:html={DROP_STALE_OVERLAY} />}
  </body>
</html>
