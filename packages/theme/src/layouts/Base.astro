---
// Every page's document: head and SEO tags, the pre-paint theme script, icons, the skip link,
// the JSON-LD graph, and the header and footer around the page body.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import tokensCss from '../styles/tokens.css?raw';
import { build, site } from 'virtual:hangfolio/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteGraph } from '../lib/jsonld.ts';
import { siteDescription } from '../lib/site.ts';
import { parseTokens } from '../lib/tokens.ts';
import { absUrl, url } from '../lib/url.ts';

interface Props {
  /** The full <title> */
  title: string;
  description?: string;
  /** Canonical path, site-relative and written exactly as the live URL (e.g. "/projects", "/writing/") */
  path: string;
  /** The nav key to mark as the current page */
  nav?: string;
  ogType?: 'website' | 'profile' | 'article';
  ogImage?: string;
  keywords?: string;
  noindex?: boolean;
  article?: { published: Date; modified?: Date; tags?: readonly string[] };
  /** Extra JSON-LD nodes for this page, added to the site graph */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = siteDescription(site),
  path,
  nav,
  ogType = 'website',
  ogImage = site.ogImage ?? site.avatar,
  keywords = site.seo?.keywords?.join(', '),
  noindex = false,
  article,
  schema = [],
} = Astro.props;

const canonical = absUrl(path);
const image = ogImage ? absUrl(ogImage) : undefined;
const personImage = site.ogImage ?? site.avatar;
const graph = siteGraph(site, personImage ? absUrl(personImage) : undefined, schema);
const { light } = parseTokens(tokensCss);
---
<!doctype html>
<html lang={site.advanced?.lang ?? 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:locale" content={site.advanced?.locale ?? 'en_US'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:type" content={ogType} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={light.bg} />
    <script is:inline>
      /* Apply a saved light/dark choice before first paint; no saved choice follows the OS */
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>

    {build.icons.map((icon) => <link rel={icon.rel} href={url(`/${icon.file}`)} type={icon.type} sizes={icon.sizes} />)}
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip" href={url('#main')}>Skip to content</a>
    <div class="wrap shell">
      <Header current={nav} />
      <main id="main" class="page" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
