---
// GitHub Pages serves this file for every missing path under the site, so every link is
// base-prefixed through url(). pages.notFound changes its title, description, heading and lede,
// or turns it off (false), which leaves GitHub's own 404 page.
import { site } from 'virtual:hangfolio/site';
import Page from '../layouts/Page.astro';
import { pageContent } from '../lib/collections.ts';
import { isPdf } from '../lib/hero.ts';
import { availablePages, pagePath } from '../lib/nav.ts';
import { pageTitle } from '../lib/site.ts';
import { url } from '../lib/url.ts';

const page = site.pages.notFound || {};
const heading = page.heading ?? 'Page not found';
const available = availablePages(site, await pageContent());
const links = [
  { label: 'Home', href: '/' },
  ...(available.has('projects') ? [{ label: 'Projects', href: pagePath(site, 'projects')! }] : []),
  ...(available.has('writing') ? [{ label: 'Writing', href: pagePath(site, 'writing')! }] : []),
  ...(site.cv ? [{ label: isPdf(site.cv) ? 'Résumé (PDF)' : 'Résumé', href: site.cv }] : []),
];
---
<Page
  title={pageTitle(site, page.title ?? heading)}
  description={page.description ?? 'This page does not exist.'}
  path="/404.html"
  noindex
  section="not-found"
  heading={heading}
  lede={page.lede ?? 'There is no page at this address. It may have moved, or the link may have a typo.'}
>
  <ul class="links">
    {links.map((link) => <li><a href={url(link.href)}>{link.label}</a></li>)}
  </ul>
</Page>
