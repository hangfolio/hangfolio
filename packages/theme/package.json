{
  "name": "hangfolio",
  "version": "0.0.0",
  "description": "A personal site for researchers and engineers, built with Astro and published on GitHub Pages.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hangfolio": "bin/hangfolio.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./content": "./src/content.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./routes/*": "./src/routes/*",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hangfolio/hangfolio.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/hangfolio/hangfolio#readme",
  "bugs": "https://github.com/hangfolio/hangfolio/issues",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 test/e2e/*.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.3.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
