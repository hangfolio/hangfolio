{
  "name": "hangfolio",
  "version": "0.1.0",
  "description": "A personal website for researchers and engineers on GitHub Pages: an Astro theme with results up front, publications from BibTeX, light and dark modes, and clear error messages.",
  "keywords": [
    "astro",
    "astro-theme",
    "academic",
    "portfolio",
    "researcher",
    "github-pages",
    "template",
    "bibtex"
  ],
  "homepage": "https://github.com/hangfolio/hangfolio#readme",
  "bugs": {
    "url": "https://github.com/hangfolio/hangfolio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hangfolio/hangfolio.git",
    "directory": "packages/theme"
  },
  "license": "MIT",
  "author": "Harris Ahmad",
  "type": "module",
  "bin": {
    "hangfolio": "bin/hangfolio.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./content": "./src/content.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./routes/*": "./src/routes/*",
    "./styles/*": "./src/styles/*",
    "./schema/*": "./schema/*",
    "./starter-values.json": "./starter-values.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "schema",
    "src",
    "starter-values.json"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "schema": "node scripts/schema.mjs",
    "starter-values": "node scripts/starter-values.mjs",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "test:golden": "node --test --test-reporter=spec test/golden.test.ts",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 test/e2e/*.test.ts",
    "test:a11y": "node --test --test-reporter=spec --test-concurrency=1 test/a11y/*.test.ts",
    "test:screenshots": "node --test --test-reporter=spec --test-concurrency=1 test/screenshots/*.test.ts",
    "test:matrix": "node --test --test-reporter=spec --test-concurrency=1 test/matrix/*.test.ts",
    "docs:check": "node --test --test-reporter=spec test/docs/*.test.ts",
    "test:starter-scenario": "node --test --test-reporter=spec --test-concurrency=1 test/e2e/starter-scenario.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@retorquere/bibtex-parser": "11.0.0",
    "astro": "7.3.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "fast-xml-parser": "5.11.2",
    "playwright-core": "1.63.0"
  }
}
